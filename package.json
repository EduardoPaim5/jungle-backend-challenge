{
  "name": "jungle-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src scripts tests .github compose.yaml '*.md' docs '*.json'",
    "format": "prettier --write src scripts tests .github compose.yaml '*.md' docs '*.json'",
    "start": "bun dist/src/main.js",
    "dev": "bun run build && bun --watch dist/src/main.js",
    "db:migrate": "bun scripts/migrate.ts up",
    "db:rollback": "bun scripts/migrate.ts down",
    "queues:init": "bun scripts/queues.ts",
    "test": "bun test tests/unit",
    "test:integration": "bun run build && bun test tests/integration --timeout 120000",
    "test:load": "bun run build && bun scripts/load.ts",
    "demo": "bun run build && bun scripts/demo.ts",
    "verify": "bun run format:check && bun run typecheck && bun run test && bun run test:integration"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1147.0",
    "@fastify/static": "10.1.5",
    "@mikro-orm/core": "7.2.4",
    "@mikro-orm/migrations": "7.2.4",
    "@mikro-orm/postgresql": "7.2.4",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
